# Environment configuration template for smartmech-video-pipeline
# Copy to .env and provide your values. DO NOT commit .env files!

# Operational settings
SMARTMECH_ENV=development
SMARTMECH_LOG_LEVEL=INFO
SMARTMECH_SQLITE_PATH=smartmech_dbos.sqlite

# Budget limits (in cost units or cents)
SMARTMECH_PER_RUN_BUDGET=10.0
SMARTMECH_PER_DAY_BUDGET=50.0

# Future Vendor API Keys (Placeholders only for M3+)
# GEMINI_API_KEY=your_gemini_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
